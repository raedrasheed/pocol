# pocol.net (SITE-06, SITE-07, 2026-11-22). Apache with mod_headers, as Studio's dist/.htaccess. The CSP allows only this
# site's own files, the explorer gateway's reads (connect-src https://explorer.pocol.net, which a page calls directly) and
# style attributes (the guide's mining illustration sets a CSS variable in style="..."). No inline script exists.
# HSTS is left to the owner (it must hold for every pocol.net subdomain first).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://explorer.pocol.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
<FilesMatch "\.(html|js|css|json|webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>
# The API configuration (api/config.php, kept on the host, never in this snapshot) is never served.
<Files "config.php">
  Require all denied
</Files>
