# /etc/pocol-disk-monitor/secret.env: the PoCol disk monitor's secrets. root:root, mode 0600 (the installer creates it
# so). Edit it on the server with: sudoedit /etc/pocol-disk-monitor/secret.env
# Never commit the real file, paste it into a chat or send it anywhere. A value still holding REPLACE_ME is unset.

# Telegram: the bot token from @BotFather and the chat id of the owner's chat with the bot (README.md, "Telegram").
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# Email: the SMTP password of SMTP_USER (monitor.conf). Leave REPLACE_ME when email is not used.
SMTP_PASSWORD=REPLACE_ME

# Optional dead-man heartbeat: an https:// ping URL (healthchecks.io-compatible). Every successful check requests it;
# with undelivered messages it requests URL/fail. The heartbeat service alerts the owner when the pings stop.
HEARTBEAT_URL=REPLACE_ME
