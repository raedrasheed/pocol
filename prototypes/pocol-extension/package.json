{
  "name": "pocol-extension",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "PoCol Studio, IDE contract wallet and verified on-chain viewer",
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/unit.mjs && node --test tests/wallet_lifecycle_test.mjs tests/site_fetch_test.mjs tests/modscan_test.mjs tests/package_release_test.mjs tests/package_store_test.mjs tests/store_listing_test.mjs tests/account_test.mjs tests/wallet_pages_test.mjs",
    "test:studio": "node tests/studio_test.mjs",
    "test:publisher": "node --test tests/publisher_test.mjs",
    "test:publisher-ui": "node --test tests/publisher_ui_test.mjs",
    "test:contracts": "node --test tests/contracts_test.mjs",
    "test:contract-ui": "node --test tests/contract_ui_test.mjs",
    "package": "node build.mjs && python3 scripts/package-release.py",
    "package:store": "node build.mjs && python3 scripts/package-store.py",
    "test:modules-browser": "node tests/module_loader_browser.mjs",
    "test:devnet-spec": "node tests/devnet_spec_fixture.mjs",
    "test:wallet-browser": "node tests/wallet_ui_browser.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.3.0",
    "ethers": "6.17.0"
  }
}
